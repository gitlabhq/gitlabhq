- data = local_assigns.fetch(:data)
- session_endpoint = local_assigns.fetch(:session_endpoint, nil)

.observability-container
  - view_data = data.to_h.merge(polling_endpoint: url_for(format: :json, only_path: true))
  - view_data[:query_params] = view_data[:query_params].to_json
  - view_data[:session_endpoint] = session_endpoint if session_endpoint.present?
  #js-observability{ data: view_data }
