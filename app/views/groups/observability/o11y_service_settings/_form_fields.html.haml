.row
  .form-group.gl-col-md-6
    = f.label :o11y_service_name, s_('Observability|Service name'), class: 'label-bold'
    = f.text_field :o11y_service_name, class: 'form-control', placeholder: 'your-o11y-instance-name'
    %span.form-text.gl-text-subtle
      = s_('Observability|The name of your o11y service instance.')

  .form-group.gl-col-md-6
    = f.label :o11y_service_user_email, s_('Observability|User email'), class: 'label-bold'
    = f.email_field :o11y_service_user_email, class: 'form-control', placeholder: 'user@example.com'
    %span.form-text.gl-text-subtle
      = s_('Observability|Email address for authentication with the o11y service.')

.row
  .form-group.gl-col-md-6
    = f.label :o11y_service_password, _('Password'), class: 'label-bold'
    = f.password_field :o11y_service_password, class: 'form-control', placeholder: '••••••••'
    %span.form-text.gl-text-subtle
      = s_('Observability|Password for authentication with the o11y service.')

  .form-group.gl-col-md-6
    = f.label :o11y_service_post_message_encryption_key, s_('Observability|Encryption key'), class: 'label-bold'
    = f.password_field :o11y_service_post_message_encryption_key, class: 'form-control', placeholder: '••••••••'
    %span.form-text.gl-text-subtle
      = s_('Observability|32+ character encryption key for secure communication.')

.row
  .form-group.gl-col-md-6
    = f.label :o11y_otel_url, s_('Observability|OTel URL override'), class: 'label-bold'
    = f.text_field :o11y_otel_url, class: 'form-control', placeholder: 'https://otel.example.com:14318', value: f.object.read_attribute(:o11y_otel_url)
    %span.form-text.gl-text-subtle
      = s_('Observability|Optional. Overrides the default OTel endpoint for exported telemetry.')

  .form-group.gl-col-md-6
    = f.label :o11y_mcp_url, s_('Observability|MCP URL override'), class: 'label-bold'
    = f.text_field :o11y_mcp_url, class: 'form-control', placeholder: 'https://mcp.example.com/mcp', value: f.object.read_attribute(:o11y_mcp_url)
    %span.form-text.gl-text-subtle
      = s_('Observability|Optional. Overrides the default MCP endpoint.')
