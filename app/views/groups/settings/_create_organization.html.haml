- return unless Organizations::Release.enabled?(:create_org_from_group_settings, group)
- return unless group.root?

- organization_docs_url = link_to('', help_page_path('user/organization/_index.md'), target: '_blank', rel: 'noopener noreferrer')

= render Pajamas::CardComponent.new do |card|
  - card.with_header do
    %h4.gl-text-base.gl-leading-24.gl-m-0= s_('GroupSettings|Create an organization')
  - card.with_body do
    = render Pajamas::AlertComponent.new(variant: :info, dismissible: false, alert_options: { class: 'gl-mb-4' }) do |alert|
      - alert.with_body do
        %h5.gl-heading-5= s_('GroupSettings|This will:')
        %ul.gl-pl-5
          %li= s_('GroupSettings|Transfer all your groups, projects, and members to the organization.')
          %li= s_('GroupSettings|Keep your data separate from other organizations.')
    %p= safe_format(s_('GroupSettings|Create an organization to manage your top-level group and its data. %{link_start}How do organizations work?%{link_end}.'), tag_pair(organization_docs_url, :link_start, :link_end))
    #js-group-settings-create-organization
