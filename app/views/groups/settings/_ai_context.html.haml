- max_length = NamespaceSetting::MAX_AI_CUSTOM_INSTRUCTIONS_LENGTH

= gitlab_ui_form_for @group, html: { class: 'gl-show-field-errors' }, authenticity_token: true do |f|
  %input{ type: 'hidden', name: 'update_section', value: 'js-ai-context-settings' }
  = form_errors(@group)

  %fieldset.form-group.gl-form-group
    = f.label :ai_custom_instructions, s_('GroupSettings|Custom instructions'), class: 'gl-block col-form-label'
    = f.text_area :ai_custom_instructions, class: 'form-control gl-form-input gl-form-textarea', rows: 4, maxlength: max_length
    %p.form-text.gl-text-subtle
      = s_("GroupSettings|Instructions appended to the AI context block on pages in this group, including its projects, for AI agents.")
      = sprintf(s_('GroupSettings|Maximum %{maxLength} characters.'), { maxLength: max_length })

  = f.submit _('Save changes'), pajamas_button: true, data: { testid: 'save-ai-context-button' }
