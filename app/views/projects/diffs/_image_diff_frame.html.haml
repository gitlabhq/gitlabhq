- class_name = local_assigns.fetch(:class_name, '')
- note_type = local_assigns.fetch(:note_type, '')

.frame{ class: class_name, data: { position: position, note_type: note_type } }
  -# The raw URL is dropped for paths with traversal segments; keep an <img> so
  -# image_diff.js can still find one.
  = image_tag(image_path || placeholder_image, alt: alt, draggable: false, lazy: false)
