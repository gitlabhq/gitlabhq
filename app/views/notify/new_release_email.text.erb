<%= _('A new release for %{name} was published.') % { name: @project.name } %>

<%= _('Visit the Releases page to read more about it:') %> <%= @target_url %>

<%= _('Assets') %>
<% @release.links.each do |link| -%>
  - <%= link.name %>: <%= link.url %>
<% end -%>
<% @release.sources.each do |source| -%>
  - <%= _('Download %{format}:') % { format: source.format } %> <%= source.url %>
<% end -%>

<%= _('Release notes') %>
<%= @release.description %>
