= gitlab_ui_form_for @application_setting, url: network_admin_application_settings_path(anchor: 'js-dependency-proxy-limits-settings'), html: { class: 'fieldset-form' } do |f|
  = form_errors(@application_setting)

  %fieldset
    %h5
      = _('Authenticated dependency proxy request rate limit')
    .form-group
      = f.gitlab_ui_checkbox_component :throttle_authenticated_dependency_proxy_enabled,
        _('Enable authenticated dependency proxy request rate limit'),
        help_text: _('Helps reduce request volume (for example, from crawlers or abusive bots)')
    .form-group
      = f.label :throttle_authenticated_dependency_proxy_requests_per_period, _('Max authenticated dependency proxy requests per period per user'), class: 'gl-font-bold'
      = f.number_field :throttle_authenticated_dependency_proxy_requests_per_period, class: 'form-control gl-form-input'
    .form-group
      = f.label :throttle_authenticated_dependency_proxy_period_in_seconds, _('Authenticated dependency proxy rate limit period in seconds'), class: 'gl-font-bold'
      = f.number_field :throttle_authenticated_dependency_proxy_period_in_seconds, class: 'form-control gl-form-input'

  = f.submit _('Save changes'), pajamas_button: true
