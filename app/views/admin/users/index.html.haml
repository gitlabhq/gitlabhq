= render_if_exists 'admin/users/minimal_access_provisioning_alert'
- page_title _("Users")
- can_admin_all_resources = can?(current_user, :admin_all_resources)

= render ::Layouts::PageHeadingComponent.new(_('Users'), options: { data: { event_tracking_load: 'true', event_tracking: 'view_admin_users_pageload' } }) do |c|
  - c.with_actions do
    - if can_admin_all_resources
      = render_if_exists 'admin/users/admin_email_users'
      = render_if_exists 'admin/users/admin_export_user_permissions'
    - if show_invite_organization_user_button?
      #js-admin-add-organization-users{ data: { app_data: invite_organization_user_app_data(@organization, has_new_user_button: can_admin_all_resources) } }
    - if can_admin_all_resources
      = render Pajamas::ButtonComponent.new(variant: :confirm, href: new_admin_user_path) do
        = s_('AdminUsers|New user')

= render 'admin/users/tabs'

.tab-content.gl-border-t
  .tab-pane.active
    = render 'admin/users/users'
