- marketplace_home_url = ::WebIde::ExtensionMarketplace.marketplace_home_url(user: @user)
- extensions_marketplace_enabled = ::WebIde::ExtensionMarketplaceOptIn.enabled?(user: @user, marketplace_home_url: marketplace_home_url)
- user_fields = { gitpod_enabled: @user.gitpod_enabled, sourcegraph_enabled: @user.sourcegraph_enabled, extensions_marketplace_enabled: extensions_marketplace_enabled }
- data_attributes = { integration_views: integration_views.to_json, user_fields: user_fields.to_json, extensions_marketplace_url: marketplace_home_url }

= render ::Layouts::SettingsSectionComponent.new(s_('Preferences|Integrations'),
  id: 'integrations',
  options: { class: 'js-preferences-form' }) do |c|
  - c.with_description do
    = s_('Preferences|Customize integrations with third party services.')
  - c.with_body do
    #js-profile-preferences-integrations{ data: data_attributes }
