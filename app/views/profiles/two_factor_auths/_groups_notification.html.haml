%details.gl-mt-3{ data: { testid: 'two-factor-groups-notification-details' } }
  %summary.gl-cursor-pointer
    = _('Review and leave groups')
  %ul.gl-list-disc.gl-pl-5.gl-ml-7.gl-mb-0.gl-mt-2{ data: { testid: 'two-factor-groups-notification' } }
    - groups.each do |group|
      - member = memberships[group.id]
      %li
        .gl-flex.gl-items-center.gl-gap-3
          = link_to group.full_name, group_path(group), class: 'gl-truncate gl-min-w-0', title: group.full_name
          - if can?(current_user, :destroy_group_member, member)
            = link_to _('Leave group'), leave_group_members_path(group), method: :delete, class: 'gl-link-inline gl-shrink-0', data: { testid: 'leave-group-link' }
          - else
            %span.gl-text-subtle.gl-shrink-0.gl-whitespace-nowrap{ data: { testid: 'leave-group-blocked' } }= _('You are the last owner')
