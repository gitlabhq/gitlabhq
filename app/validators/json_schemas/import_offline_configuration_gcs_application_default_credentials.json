{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Import::Offline::Configuration#object_storage_credentials for Google Cloud Storage using Application Default Credentials (fog-google JSON API)",
  "type": "object",
  "additionalProperties": false,
  "if": { "minProperties": 1 },
  "then": {
    "required": [
      "google_project"
    ]
  },
  "properties": {
    "google_project": {
      "type": "string",
      "minLength": 7,
      "maxLength": 30,
      "pattern": "^[a-z][a-z0-9-]{5,28}[a-z0-9]$"
    }
  }
}
