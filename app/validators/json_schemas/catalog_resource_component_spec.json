{
  "description": "Catalog Resource Component Spec",
  "type": "object",
  "properties": {
    "inputs": {
      "type": "object",
      "patternProperties": {
        ".*": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "default": {
              "type": [
                "array",
                "boolean",
                "number",
                "string",
                "null"
              ]
            },
            "regex": {
              "type": "string"
            },
            "type": {
              "type": "string"
            }
          }
        }
      }
    },
    "inputs_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "component": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "name",
          "sha",
          "version",
          "reference"
        ]
      },
      "uniqueItems": true
    },
    "description": {
      "type": "string",
      "maxLength": 256
    }
  },
  "additionalProperties": false
}
