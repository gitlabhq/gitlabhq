+      const parentAppContext = options.parent.$.appContext;
+      const parentGlobalProps = parentAppContext && parentAppContext.config && parentAppContext.config.globalProperties;
+      if (parentGlobalProps) {
+        for (const key of Object.keys(parentGlobalProps)) {
+          if (!(key in app.config.globalProperties)) {
+            app.config.globalProperties[key] = parentGlobalProps[key];
+          }
+        }
+      }
+    }
     const vm = app._createRoot(options);
     if (options.el) {
       return vm.$mount(options.el);
