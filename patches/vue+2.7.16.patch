+++ b/node_modules/vue/dist/vue.runtime.common.dev.js
@@ -5673,10 +5673,18 @@ function resolveConstructorOptions(Ctor) {
             // check if there are any late-modified/attached options (#4976)
             const modifiedOptions = resolveModifiedOptions(Ctor);
             // update base extend options
+            // GitLab: keep late-modified options off Ctor.extendOptions. That object is the
+            // component's own export, which may be shared with a @vue/compat realm, and
+            // the merged `directives`/`components` written here would leak into it.
+            // Remove once GitLab runs on a single Vue version and no `.vue` export is
+            // shared between realms. See
+            // https://gitlab.com/gitlab-org/gitlab/-/merge_requests/256620#note_3903912326
             if (modifiedOptions) {
-                extend(Ctor.extendOptions, modifiedOptions);
+                Ctor.gitlabModifiedOptions = extend(Ctor.gitlabModifiedOptions || {}, modifiedOptions);
             }
-            options = Ctor.options = mergeOptions(superOptions, Ctor.extendOptions);
+            options = Ctor.options = mergeOptions(superOptions, Ctor.gitlabModifiedOptions
+                ? extend(extend({}, Ctor.extendOptions), Ctor.gitlabModifiedOptions)
+                : Ctor.extendOptions);
             if (options.name) {
                 options.components[options.name] = Ctor;
             }
