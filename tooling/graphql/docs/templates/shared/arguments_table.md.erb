<% show_default = @arguments.any?(&:default_value?) %>
| Name | Type | Description<%= ' | Default' if show_default %> |
| ---- | ---- | -----------<%= ' | -------' if show_default %> |
<% sorted_by_name(@arguments).each do |argument| %>
| <%= name(argument) %> | <%= type(argument) %> | <%= description(argument).squish %><%= " | #{default_arg_value(argument)}" if show_default %> |
<% end %>
